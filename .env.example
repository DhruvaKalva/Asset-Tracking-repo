DATABASE_URL=sqlite:///./smartrental.db
# swap for prod, no code change:
# DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/smartrental
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
OVERDUE_SCAN_MINUTES=5
ANOMALY_SCAN_MINUTES=15
SIMULATOR_ENABLED=true
SIMULATOR_TICK_SECONDS=5
SIMULATOR_HOURS_PER_TICK=0.05

# Mira dashboard assistant (Google Gemini). Blank disables the feature.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
